<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>59b77bbb-bf26-4b6e-a088-d9b454e5fd8d</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Shift Report</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Reply All + Card"/>
  <Description DefaultValue="Reply All on the open mail with the shift hourly report card inserted as a table. Never sends."/>
  <IconUrl DefaultValue="https://alyessam69.github.io/shift-hourly-report/icon-192.png"/>
  <HighResolutionIconUrl DefaultValue="https://alyessam69.github.io/shift-hourly-report/icon-192.png"/>
  <SupportUrl DefaultValue="https://alyessam69.github.io/shift-hourly-report/"/>
  <AppDomains>
    <AppDomain>https://alyessam69.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://alyessam69.github.io/shift-hourly-report/addin/pane.html"/>
        <RequestedHeight>320</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.8">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="shrGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="shrReplyAllCard">
                    <Label resid="ButtonLabel"/>
                    <Supertip>
                      <Title resid="ButtonLabel"/>
                      <Description resid="ButtonTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16"/>
                      <bt:Image size="32" resid="Icon32"/>
                      <bt:Image size="80" resid="Icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="PaneUrl"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="https://alyessam69.github.io/shift-hourly-report/favicon.png"/>
          <bt:Image id="Icon32" DefaultValue="https://alyessam69.github.io/shift-hourly-report/favicon.png"/>
          <bt:Image id="Icon80" DefaultValue="https://alyessam69.github.io/shift-hourly-report/apple-touch-icon.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="PaneUrl" DefaultValue="https://alyessam69.github.io/shift-hourly-report/addin/pane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Shift report"/>
          <bt:String id="ButtonLabel" DefaultValue="Reply All + Card"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ButtonTip" DefaultValue="Open the panel: paste the card once, then Reply All on the open mail with the table inside. Never sends."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
